# WAHA WhatsApp HTTP API
WAHA_DASHBOARD_USERNAME=changeme
WAHA_DASHBOARD_PASSWORD=changeme
WAHA_API_KEY=changeme

# PostgreSQL
POSTGRES_DB=jawara
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme

# Anonymization — SHA-256(USER_HASH_SALT + ':' + phone/group id) becomes user_hash.
# Rotating this orphans every existing user_subscriptions row; treat as a data migration.
USER_HASH_SALT=changeme

# Webhook rate limit (sliding window, per session+chat)
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# Vector DB — 1536 = text-embedding-3-small, 768 = IndoBERT.
# Changing EMBEDDING_DIM means recreating the collection and re-embedding
# everything: Qdrant cannot resize a collection in place.
QDRANT_COLLECTION=fact_knowledge_base
EMBEDDING_DIM=1536

# ML Service (standalone) — internal service-to-service key, never exposed publicly
ML_SERVICE_API_KEY=changeme

# Retrieval quality — claim extraction + re-ranking.
# A forwarded WhatsApp message is a claim wrapped in greetings, emoji and
# "TOLONG SEBARKAN!!!"; embedding the wrapper is what makes a knowledge base
# that does hold the answer return nothing. "auto" uses the configured LLM when
# there is one and a deterministic offline heuristic otherwise; "heuristic"
# forces the offline path (no extra LLM call in the <3s budget); "llm" forces
# the model. RAG_CLAIM_EXTRACTION_ENABLED=false skips the step entirely.
RAG_CLAIM_EXTRACTION_ENABLED=true
CLAIM_EXTRACTION_PROVIDER=auto
# Messages shorter than this are already claims and are passed through as-is.
CLAIM_EXTRACTION_MIN_INPUT_CHARS=180
# Re-ranking reorders retrieved matches by source reliability and freshness —
# it never changes which matches passed the similarity threshold, and `score`
# stays the raw cosine similarity in the audit row. Each weight is the maximum
# penalty its signal may apply; 0 disables that signal exactly.
RAG_RERANK_ENABLED=true
RAG_RELIABILITY_WEIGHT=0.4
RAG_RECENCY_WEIGHT=0.25
# Days at which the freshness factor halves. An old debunk of a recirculating
# hoax must stay retrievable, so this decays rather than expires.
RAG_RECENCY_HALF_LIFE_DAYS=180

# Continuous fact-check ingestion — Celery Beat pulls new fact-checks from
# external fact-check organisations into fact_items, then through the normal
# knowledge sync into Qdrant. false stops the scheduler; the Control Panel's
# manual trigger still works.
FACT_INGESTION_ENABLED=true
# Adapter slugs, comma-separated. Only "turnbackhoax" exists today.
FACT_INGESTION_SOURCES=turnbackhoax
# TurnBackHoax's feed holds only the 10 newest articles and they publish
# roughly 5-15 a day: hourly cannot miss one between runs and costs the source
# 24 requests a day. Raise it, don't lower it, unless you know the source's
# rate limits.
FACT_INGESTION_INTERVAL_MINUTES=60
FACT_INGESTION_MAX_ITEMS=25
# Minimum gap between two requests to the same source — politeness, not speed.
FACT_INGESTION_REQUEST_DELAY_SECONDS=1.5
# Fact-check organisations publish corrections, so a stored article is re-read
# at most this often, and only while it is younger than the window below.
# 0 hours turns re-checking off and makes ingestion append-only.
FACT_INGESTION_REFRESH_AFTER_HOURS=24
FACT_INGESTION_REFRESH_WINDOW_DAYS=7
# Identify the crawler and leave the source's operators a way to reach you.
FACT_INGESTION_USER_AGENT=JAWARA-FactCheckBot/1.0 (+https://github.com/dendik-creation)
# Push freshly ingested facts to Qdrant at the end of a run. false leaves them
# in PostgreSQL for an operator to review and sync by hand.
FACT_INGESTION_AUTO_SYNC=true
TURNBACKHOAX_FEED_URL=https://turnbackhoax.id/feed

# Embeddings: "hash" (deterministic, offline, no key) or "openai" (text-embedding-3-small)
EMBEDDING_PROVIDER=hash

# LLM: "anthropic" is the chosen production provider, "openai_compatible" any
# Chat Completions API that speaks the same wire format (OpenAI itself,
# OpenRouter, Groq, Google AI Studio / Gemini, a self-hosted vLLM/Ollama, ...),
# "template" the deterministic offline composer used when no key is
# configured. A provider without its key falls back to "template" and says so
# in the readiness payload.
LLM_PROVIDER=template
LLM_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
# openai_compatible only. LLM_BASE_URL up to and including /v1 — the provider
# appends /chat/completions itself.
#
# Google AI Studio / Gemini (API key from aistudio.google.com) speaks the same
# wire format at its own /openai compat layer — no separate provider needed:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=<Google AI Studio API key>
#   LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=
LLM_API_KEY=

# Embeddings only (EMBEDDING_PROVIDER=openai above) — unrelated to the LLM
# settings above even though both may point at the same vendor.
OPENAI_API_KEY=

# External threat intelligence. Empty = provider disabled; URL verdicts degrade
# to UNKNOWN instead of failing the pipeline.
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=

# Control Panel access. Every endpoint requires an operator session token; there
# is no shared secret and no open mode. The first account is created from
# OPERATOR_EMAIL/OPERATOR_NAME/OPERATOR_PASSWORD below as part of setup:
#   cd backend && uv run python -m app.scripts.create_operator
# Re-running it is safe — an existing account is left untouched (use
# --reset-password to change one). Change OPERATOR_PASSWORD after first login;
# nothing rotates it automatically.
OPERATOR_EMAIL=changeme@example.com
OPERATOR_NAME=Admin
OPERATOR_PASSWORD=changeme
# Session lifetime in minutes (480 = one 8-hour shift) and bcrypt cost.
AUTH_SESSION_TTL_MINUTES=480
AUTH_BCRYPT_ROUNDS=12
# Login attempts per (email, client IP) inside the window, then 429.
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
CORS_ALLOW_ORIGINS=http://localhost:3001,http://localhost:3000

# Group behaviour. In a WhatsApp group the bot answers only when addressed —
# mentioned (@62...) or replied to. Setting this false makes it answer every
# message in the group: spam, and a fast way to get the number banned. Only sane
# in a throwaway test group.
GROUP_REPLY_REQUIRES_TRIGGER=true
# Normally discovered from WAHA (`me.id` and its `@lid` twin). Set only when that
# lookup cannot be made, e.g. 6281234567890@c.us,249117464891485@lid
BOT_WHATSAPP_IDS=

# Privacy — false stops message content being written to message_logs.extracted_text
LOG_MESSAGE_CONTENT=true

# Logging
LOG_LEVEL=INFO

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Services Port — host ports Compose publishes. They double as the connection
# details a locally run backend/worker uses: without DATABASE_URL / REDIS_URL /
# ML_SERVICE_URL in the environment, the backend builds them from POSTGRES_*,
# REDIS_PORT and ML_SERVICE_PORT against localhost. Inside Compose the explicit
# URLs (with in-network hostnames) take precedence.
WAHA_PORT=3000
API_GATEWAY_PORT=8000
ML_SERVICE_PORT=9000
QDRANT_PORT=6333
FRONTEND_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
